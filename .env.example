# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#     set -a && source .env && set +a
# `.env` is git-ignored. NEVER commit real keys. Every variable the
# code reads is listed here with a comment saying where to get it.
#
# Neither key is required to explore the repo: pre-computed results
# for every leaf already live in results/RESULTS.md and each leaf's
# scored.json. You only need these to RE-RUN the benchmark yourself.
# ─────────────────────────────────────────────────────────────

# DeepSeek API key (hosted model in the size ladder) — get one at
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-key-here

# Google Gemini API key (used by the optional frontier-model sweep,
# engine/models.py GeminiClient) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
