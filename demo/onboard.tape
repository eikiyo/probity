Output onboard.gif

Set Shell "bash"
Set FontSize 14
Set Width 1050
Set Height 640
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 80ms

Hide
Type "export HOME=/tmp/probity_demo_recording_home"
Enter
Type "rm -rf $HOME && mkdir -p $HOME"
Enter
Type "source /tmp/probity_test_venv3/bin/activate"
Enter
Type "clear"
Enter
Show

Type "probity-bench onboard"
Enter
Sleep 3.5s

Type "none"
Enter
Sleep 3.5s

Type "gemma3:1b, deepseek"
Enter
Sleep 4s

Type "n"
Enter
Sleep 3s

Enter
Sleep 3.5s

Sleep 5s
